# MCP Center 環境變數
# cp .env.example .env
#
# 全部都可留空:預設用 SQLite、密鑰自動產生並存到 data/secrets.json。
# 只有「對外部署」時 OAUTH_ISSUER 一定要改成公開網址。

# ---- 資料庫(預設 SQLite;PostgreSQL 範例:postgresql://user:pwd@localhost/mcp_center)----
# DATABASE_URL=sqlite:///data/mcp_center.db

# ---- 對外網址(唯一真的需要看一眼的設定)----
# 寫進每個 token 的 iss;MCP server / client 用它做 discovery。程式會直接 bind 這個 port。
#   本機:            http://localhost:4568
#   區網其他機器要用: http://192.168.1.10:4568
#   反向代理 / 網域:  https://mcp.yourdomain.com(此時 bind 4568,由 nginx 轉進來)
OAUTH_ISSUER=http://localhost:4568
# OAUTH_ACCESS_EXPIRE_MINUTES=60
# OAUTH_REFRESH_EXPIRE_DAYS=30
# OAUTH_DCR_AUTO_APPROVE=true

# ---- 密鑰(留空則自動產生並持久化到 data/secrets.json)----
# 管理台 session cookie 簽章
# SESSION_SECRET_KEY=
# 靜態資料加密(私鑰、服務 token、容器 env):設定後請勿更換
# ENCRYPTION_KEY=

# ---- 首次啟動自動建立擁有者帳號(不設則開啟 http://localhost:4568/setup 建立)----
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me

# ---- 管理台第三方登入接口(選填;填了才會出現在登入頁)----
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- 其他 ----
# LOG_LEVEL=INFO
# SECURE_COOKIE=false
# ENABLE_API_DOCS=true
# 進階:只有 bind 位址 / port 要和 OAUTH_ISSUER 不同時才設(例如反向代理後面只聽本機)
# SERVER_HOST=0.0.0.0
# SERVER_PORT=4568
