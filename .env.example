# MCP Center environment variables
# cp .env.example .env
#
# Everything may be left empty: SQLite is used by default and keys are generated and stored in data/secrets.json.
# Only for a public deployment must OAUTH_ISSUER be changed to the public URL.

# ---- Database (SQLite by default; PostgreSQL example: postgresql://user:pwd@localhost/mcp_center) ----
# DATABASE_URL=sqlite:///data/mcp_center.db

# ---- Public URL (the only setting that really needs a look) ----
# Written into the iss of every token; MCP servers / clients use it for discovery. The app binds this port directly.
#   Local only:                    http://localhost:4568
#   Other machines on the LAN:     http://192.168.1.10:4568
#   Reverse proxy / domain:        https://mcp.yourdomain.com (binds 4568 here; nginx forwards to it)
OAUTH_ISSUER=http://localhost:4568
# OAUTH_ACCESS_EXPIRE_MINUTES=60
# OAUTH_REFRESH_EXPIRE_DAYS=30
# OAUTH_DCR_AUTO_APPROVE=true

# ---- Secrets (leave empty to generate and persist them in data/secrets.json) ----
# Admin console session cookie signing
# SESSION_SECRET_KEY=
# Encryption at rest (private keys, service tokens, container env): never change it once set
# ENCRYPTION_KEY=

# ---- Owner account created automatically on first start (if unset, open http://localhost:4568/setup to create it) ----
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me

# ---- Admin console third-party login providers (optional; only shown on the login page when filled in) ----
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Other ----
# LOG_LEVEL=INFO
# SECURE_COOKIE=false
# ENABLE_API_DOCS=true
# Advanced: set only when the bind address / port must differ from OAUTH_ISSUER
# (e.g. listening on localhost only behind a reverse proxy)
# SERVER_HOST=0.0.0.0
# SERVER_PORT=4568
